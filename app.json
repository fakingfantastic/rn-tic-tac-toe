{
    "expo": {
        "name": "Tic Tac Toe!",
        "slug": "Tic Tac Toe!",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "rntictactoe",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.fastdraft.rn-tic-tac-toe"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#E6F4FE",
                "foregroundImage": "./assets/images/adaptive-icon.png",
                "backgroundImage": "./assets/images/adaptive-icon.png",
                "monochromeImage": "./assets/images/adaptive-icon.png"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.fastdraft.rntictactoe"
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "image": "./assets/images/splash.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#d0d0d0",
                    "dark": {
                        "backgroundColor": "#000000"
                    }
                }
            ],
            [
                "expo-font",
                {
                    "fonts": [
                        "node_modules/@expo-google-fonts/fredoka/600SemiBold/Fredoka_600SemiBold.ttf",
                        "node_modules/@expo-google-fonts/fredoka/700Bold/Fredoka_700Bold.ttf"
                    ]
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}
